# Veritas environment variables
# Copy to .env and adjust as needed.

# ── Backend ─────────────────────────────────────────────────────────────────

# Production verifier checkpoint (DistilRoBERTa NLI)
VERITAS_VERIFIER_CHECKPOINT=checkpoints/transformer_verifier_clean

# CORS allowed origins for frontend (comma-separated)
VERITAS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Evidence corpus for retrieval
VERITAS_EVIDENCE_CORPUS=data/processed/evidence_corpus.jsonl

# Config file
VERITAS_CONFIG=configs/serving.yaml

# Verifier backend (auto | transformer | sklearn | mock)
VERITAS_VERIFIER_BACKEND=auto

# Checkpoint paths
VERITAS_SKLEARN_CHECKPOINT=checkpoints/verifier
VERITAS_TRANSFORMER_CHECKPOINT=checkpoints/transformer_verifier_clean

# Retrieval settings
VERITAS_EMBEDDING_BACKEND=hashing
VERITAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VERITAS_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Serving settings
VERITAS_MAX_EVIDENCE=5
VERITAS_CACHE_TTL_SECONDS=120
VERITAS_LOG_LEVEL=INFO

# ── Frontend ─────────────────────────────────────────────────────────────────

# Backend API URL (used by Vite frontend)
VITE_API_BASE_URL=http://localhost:8000

# ── Optional: vLLM explanation server ────────────────────────────────────────
# VERITAS_VLLM_BASE_URL=http://127.0.0.1:8001
